# --- Firebase Authentication (GitHub sign-in) ----------------------------
# Copy to `.env` (or set in your host's environment) and fill in from:
#   Firebase console -> Project settings -> General -> Your apps -> Web app
#
# These values are PUBLIC by design. Firebase web config ships in every
# client bundle and Firebase's own documentation says so — access is
# controlled by Security Rules and by the Authorized domains list, not by
# keeping this key hidden. They live in env vars for per-environment
# configuration, not for secrecy.
#
# The value that IS secret — the GitHub OAuth app's Client Secret — is
# pasted into the Firebase console, never into this file or this codebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Optional; unused by this app but harmless to set.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Where a signed-in user is sent. Defaults to the deployed hub.
VITE_DASHBOARD_URL=https://ghic-hub.vercel.app

# --- Setup checklist ------------------------------------------------------
# 1. Firebase console -> Authentication -> Sign-in method -> enable GitHub.
#    It shows you a callback URL like:
#      https://<project>.firebaseapp.com/__/auth/handler
#
# 2. GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
#      Homepage URL:               your marketing site URL
#      Authorization callback URL: the Firebase URL from step 1
#    Copy the Client ID and generate a Client Secret.
#
# 3. Paste that Client ID + Secret back into the Firebase GitHub provider,
#    and save.
#
# 4. Firebase console -> Authentication -> Settings -> Authorized domains:
#    add localhost and your production domain. Sign-in fails with
#    "auth/unauthorized-domain" until you do.
#
# Note: this OAuth app is for SIGN-IN only. It is separate from the GHIC
# GitHub App that gets installed on repositories — that one carries the
# Issues permissions and is consented separately.
#
# For that GitHub App, set the Setup URL to:
#   https://<your-marketing-domain>/github/setup
#
# After install/update, GitHub sends users there with `installation_id` and
# `setup_action`; the marketing app forwards them to VITE_DASHBOARD_URL.
